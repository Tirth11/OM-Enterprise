# Environment Configuration
# Copy this to .env and fill in your values

# Database
DATABASE_URL=postgresql://username:password@localhost:5432/self_weld_industries

# JWT
JWT_SECRET=your-super-secret-key-change-this

# Server
PORT=5000
NODE_ENV=development

# Email/SMS (for OTP sending - configure based on your provider)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-sid
# TWILIO_AUTH_TOKEN=your-token
# TWILIO_PHONE_NUMBER=+1234567890

# Business Details
WHATSAPP_NUMBER=91XXXXXXXXXX
BUSINESS_EMAIL=admin@selfweldindustries.com
BUSINESS_PHONE=91XXXXXXXXXX
